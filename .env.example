# Postgres. The new schema is `spread`; public.* is read through views.
DATABASE_URL=postgres://user:pass@host:5432/dbname
PG_POOL_MAX=10
PG_STATEMENT_TIMEOUT_MS=20000

# Claude, for the AI layer. Server-side only — the browser never sees this.
ANTHROPIC_API_KEY=

# Read-only role for MCP: scripts/create-ai-ro-role.sql creates it; the
# password goes into MCP_DATABASE_URL below. Never in a migration.

# The port THIS service listens on. The BACKEND is 4000; the SCRAPER's ingest
# API is 8787 and is a different process in a different repo. The front end's
# Vite proxy targets both, so getting this wrong makes every fetch 404 and the
# screen look broken for a reason that is not in the code.
PORT=4000

# TESTS. The DB suites REFUSE any database whose name does not end in _test
# (test/dbguard.js) — they insert and delete rows. Point this at a schema copy
# of kse and run `DATABASE_URL=$TEST_DATABASE_URL npm test`.
# TEST_DATABASE_URL=postgres://user:pass@host:5432/kse_test

# ─── PHASE 3 · AUTH ─────────────────────────────────────────────────────────
# One shared secret for the API AND the socket. With it unset, both answer
# loopback only (reads included). NODE_ENV=production refuses to start without
# it, with fewer than 24 characters, or with CORS_ORIGIN unset/"*".
# D3 · this is the SERVICE token — the scraper, the scripts, the cron jobs.
# It is NOT in the terminal's bundle any more: the terminal signs in (below).
# Never reuse it as the scraper's INGEST_TOKEN.
SPREAD_API_TOKEN=

# ─── D3 · THE TERMINAL SIGNS IN ─────────────────────────────────────────────
# The SPA signs in with Firebase Auth (Google) and sends its ID token; the
# backend verifies it with the Admin SDK (a local signature check against
# Google's public keys — no service-account credential needed for that) and
# then requires the uid to be listed. Production refuses to start without both.
# FIREBASE_PROJECT_ID=jk-traders-5c752
# SPREAD_ALLOWED_UIDS=<your uid — shown in the Firebase console after the first sign-in>
# GOOGLE_APPLICATION_CREDENTIALS=/etc/spread/firebase-sa.json   # optional; outside the repo
#
# The depth slots are proxied for the terminal (GET/POST /api/slots): set
# SCRAPER_INGEST_URL=http://127.0.0.1:8787/ingest and INGEST_TOKEN=<the scraper's
# token> here — the scraper's token never reaches a browser.
# Behind a reverse proxy (nginx → 127.0.0.1:4000) set this — a hop count,
# 'loopback', or an IP/CIDR list — so req.ip is the client, not nginx. Once
# set, NOTHING counts as loopback: the token is required from every caller,
# whether or not nginx sends X-Forwarded-For.
# TRUST_PROXY=1
CORS_ORIGIN=http://localhost:3000
# The MCP server refuses DATABASE_URL and needs its own read-only role.
MCP_DATABASE_URL=postgres://ai_ro:pass@host:5432/kse
# Ceiling on one Anthropic call, ms. /ai/ask is also limited to 10/min per client, 2 in flight.
AI_CALL_TIMEOUT_MS=45000

# ─── LOGGING (3.7) ──────────────────────────────────────────────────────────
# One JSON line per event on stdout (warn/error on stderr). LOG_FORMAT=pretty
# is the default on a TTY. LOG_LEVEL=debug|info|warn|error.
# LOG_LEVEL=info
# LOG_FORMAT=json

# ─── WHATSAPP ALERTS (TRADEABLE halt-resumes) ───────────────────────────────
# The halt scanner pushes ONE line — "FUTUREKID resumed 142 · TRADEABLE ·
# target 147 stop 137" — to WhatsApp for every TRADEABLE resume. The window is
# ~2 minutes, so the push is often the only way to be in time. Leave everything
# below unset and no push is sent (each alert is still LOGGED, not silent).
#
# WHATSAPP_PROVIDER=gupshup      # 'gupshup' (chosen) | 'meta' | 'twilio'
# WHATSAPP_TO=+96599999999       # the operator's number — one recipient
# WHATSAPP_TIMEOUT_MS=5000       # each send is bounded; the scanner never blocks
#
# --- Gupshup WhatsApp (api.gupshup.io) — the chosen provider ---
# WHATSAPP_GUPSHUP_APIKEY=<your Gupshup apikey>
# WHATSAPP_GUPSHUP_SOURCE=+965XXXXXXXX   # the approved WhatsApp source number
# WHATSAPP_GUPSHUP_APP=<your Gupshup app name>   # the src.name
#
# --- Meta WhatsApp Cloud API (graph.facebook.com) ---
# WHATSAPP_META_PHONE_ID=<the phone-number id from Meta Business>
# WHATSAPP_META_TOKEN=<a permanent access token>
# WHATSAPP_META_TEMPLATE=halt_resume   # a PRE-APPROVED template with ONE body
#   # parameter. REQUIRED unless the recipient messaged your number in the last
#   # 24 hours — Meta drops free-form text outside that window. Leave unset to
#   # send plain text (only reaches you inside a 24-hour customer-service window).
# WHATSAPP_META_LANG=en
#
# --- Twilio WhatsApp (api.twilio.com) — simplest to stand up ---
# WHATSAPP_TWILIO_SID=AC...
# WHATSAPP_TWILIO_TOKEN=<auth token>
# WHATSAPP_TWILIO_FROM=whatsapp:+14155238886   # the Twilio sandbox or your sender

# ─── PRODUCTION ─────────────────────────────────────────────────────────────
# The server REFUSES to start with NODE_ENV=production unless SPREAD_API_TOKEN
# is set and CORS_ORIGIN is one exact origin (src/index.js checks this before
# it opens a database connection). A complete production .env:
#
#   NODE_ENV=production
#   SPREAD_API_TOKEN=<32+ random bytes, base64: openssl rand -base64 48>
#   CORS_ORIGIN=https://<the single origin the terminal is served from>   # never *
#   DATABASE_URL=postgres://spread_rw@…/kse
#   MCP_DATABASE_URL=postgres://ai_ro@…/kse          # scripts/create-ai-ro-role.sql
#   AI_CALL_TIMEOUT_MS=45000
#   ANTHROPIC_MODEL=<pinned exact model id>           # unset = code default, warned at boot
#   ANTHROPIC_API_KEY=…
#   PORT=4000
#
#   TRUST_PROXY=1                                     # behind nginx: no loopback exemption at all
#   FIREBASE_PROJECT_ID=jk-traders-5c752              # D3: the terminal's sign-in
#   SPREAD_ALLOWED_UIDS=<uid>                         # D3: who may use it
#   SCRAPER_INGEST_URL=http://127.0.0.1:8787/ingest   # D3: the slots proxy + halt swaps
#   INGEST_TOKEN=<the scraper's token>
#
# ecosystem.config.js starts with NODE_ENV=production by default; use
# `pm2 start ecosystem.config.js --env development` for a local run. See
# README "Production".
